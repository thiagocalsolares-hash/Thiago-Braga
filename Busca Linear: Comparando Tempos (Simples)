import random
import time

# 1. Criar uma lista com 10.000 números aleatórios
lista = random.sample(range(1, 100001), 10000)

# 2. Definir os elementos que serão procurados
elemento_inicio = lista[0]
elemento_meio = lista[len(lista) // 2]
elemento_final = lista[-1]
elemento_inexistente = 200000

# 3. Criar uma função para realizar a busca e medir o tempo
def buscar_elemento(lista, elemento):
    inicio = time.time()

    encontrado = elemento in lista

    fim = time.time()
    tempo_busca = fim - inicio

    print(f"Elemento procurado: {elemento}")
    print(f"Encontrado: {encontrado}")
    print(f"Tempo de busca: {tempo_busca:.10f} segundos")
    print("-" * 40)


# 4. Realizar as quatro buscas
print("RESULTADO DAS BUSCAS\n")

buscar_elemento(lista, elemento_inicio)
buscar_elemento(lista, elemento_meio)
buscar_elemento(lista, elemento_final)
buscar_elemento(lista, elemento_inexistente)
