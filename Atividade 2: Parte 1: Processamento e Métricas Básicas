# 2. Calcula o valor total de uma venda
def calcular_valor_total_venda(registro_venda_tupla):
    quantidade_vendida = registro_venda_tupla[3]
    valor_unitario = registro_venda_tupla[4]

    return quantidade_vendida * valor_unitario


# 3. Calcula o faturamento total de todas as vendas
def calcular_faturamento_total_geral(lista_registros):
    faturamento_total = 0

    for registro in lista_registros:
        faturamento_total += calcular_valor_total_venda(registro)

    return faturamento_total


# 4. Retorna os códigos dos produtos sem repetição
def produtos_vendidos_unicos(lista_registros):
    produtos_unicos = []

    for registro in lista_registros:
        codigo_produto = registro[1]

        if codigo_produto not in produtos_unicos:
            produtos_unicos.append(codigo_produto)

    return produtos_unicos


