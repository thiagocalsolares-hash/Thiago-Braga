# Lista de nome de amigos
nomes = ["Joao", "Vitor", "Fabio", "Manuel", "Nelson"]
chave = "Nelson"
encontrado = False
posicao_encontrada = -1 # Usamos -1 para indicar que ainda não foi encontrado

# Percorrendo a lista
for i in range(len(nomes)):
  if nomes[i] == chave:
    encontrado = True
    posicao_encontrada = i
    break # Para a busca assim que encontrar

# Verificando o resultado
if encontrado:
  print(f"O amigo '{chave}' foi encontrada na posição {posicao_encontrada}.")
else:
  print(f"O amigo '{chave}' não foi encontrada na lista.")
