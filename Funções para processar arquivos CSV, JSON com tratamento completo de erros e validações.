import json

def processar_json(caminho_arquivo, chaves_obrigatorias=None, validacao_customizada=None):
    """
    Processa um arquivo JSON com tratamento de erros.

    Args:
        caminho_arquivo (str): O caminho para o arquivo JSON.
        chaves_obrigatorias (list, optional): Uma lista de chaves que devem estar presentes em cada objeto JSON (se for uma lista de objetos).
        validacao_customizada (callable, optional): Uma função de validação customizada que recebe os dados JSON e retorna True ou False.

    Returns:
        dict or list or None: Os dados JSON carregados se o processamento for bem-sucedido, caso contrário None.
    """
    try:
        with open(caminho_arquivo, 'r', encoding='utf-8') as f:
            dados = json.load(f)
        print(f"Arquivo JSON '{caminho_arquivo}' lido com sucesso.")

        # Validação de chaves obrigatórias (para lista de dicionários)
        if chaves_obrigatorias and isinstance(dados, list):
            for i, item in enumerate(dados):
                if isinstance(item, dict):
                    chaves_ausentes = [chave for chave in chaves_obrigatorias if chave not in item]
                    if chaves_ausentes:
                        print(f"Erro de Validação: Objeto na posição {i} não possui as chaves obrigatórias: {', '.join(chaves_ausentes)}")
                        return None
                else:
                    print(f"Erro de Validação: Item na posição {i} não é um dicionário para validação de chaves.")
                    return None
            print("Validação de chaves: OK.")
        elif chaves_obrigatorias and isinstance(dados, dict):
            chaves_ausentes = [chave for chave in chaves_obrigatorias if chave not in dados]
            if chaves_ausentes:
                print(f"Erro de Validação: O objeto JSON não possui as chaves obrigatórias: {', '.join(chaves_ausentes)}")
                return None
            print("Validação de chaves: OK.")

        # Validação customizada
        if validacao_customizada:
            if not validacao_customizada(dados):
                print("Erro de Validação: A validação customizada falhou.")
                return None
            print("Validação customizada: OK.")

        return dados

    except FileNotFoundError:
        print(f"Erro: O arquivo '{caminho_arquivo}' não foi encontrado.")
        return None
    except json.JSONDecodeError as e:
        print(f"Erro de Análise: Houve um problema ao analisar o arquivo JSON '{caminho_arquivo}': {e}")
        return None
    except Exception as e:
        print(f"Ocorreu um erro inesperado ao processar o arquivo JSON '{caminho_arquivo}': {e}")
        return None
