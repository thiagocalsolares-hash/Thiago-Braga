# 6. Calcula o faturamento total por produto
def calcular_faturamento_por_produto(lista_registros):
    faturamento_produtos = {}

    for registro in lista_registros:
        codigo_produto = registro[1]
        valor_venda = calcular_valor_total_venda(registro)

        if codigo_produto in faturamento_produtos:
            faturamento_produtos[codigo_produto] += valor_venda
        else:
            faturamento_produtos[codigo_produto] = valor_venda

    return faturamento_produtos


# 7. Calcula a quantidade total vendida por região
def calcular_quantidade_vendida_por_regiao(lista_registros):
    quantidade_regioes = {}

    for registro in lista_registros:
        regiao = registro[2]
        quantidade = registro[3]

        if regiao in quantidade_regioes:
            quantidade_regioes[regiao] += quantidade
        else:
            quantidade_regioes[regiao] = quantidade

    return quantidade_regioes


