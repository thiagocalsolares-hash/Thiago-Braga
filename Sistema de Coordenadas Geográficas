    distancia = calcular_distancia(cidade1, cidade2)

    if distancia is not None:
        print(
            f"\nDistancia entre {cidade1} e {cidade2}: "
            f"{distancia:.2f} km"
        )
    else:
        print("\nUma das cidades nao foi encontrada.")

    referencia = "Rio de Janeiro"
    limite = 500

    print(f"\nCidades a ate {limite} km de {referencia}:")

    proximas = encontrar_cidades_proximas(referencia, limite)

    if proximas:
        for cidade, distancia in proximas:
            print(f"- {cidade}: {distancia:.2f} km")
    else:
        print("Nenhuma cidade encontrada nesse limite.")

    print("\n=== CIDADES AGRUPADAS POR REGIAO ===")

    grupos = agrupar_por_regiao()

    for regiao, lista_cidades in sorted(grupos.items()):
        print(f"\n{regiao}:")
        for cidade in sorted(lista_cidades):
            print(f"- {cidade}")
