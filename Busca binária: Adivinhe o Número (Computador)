def jogo_busca_binaria():
    print("=== JOGO DE ADIVINHAÇÃO ===")
    print("Pense em um número entre 1 e 100.")
    print("Responda: maior, menor ou igual.\n")

    inicio = 1
    fim = 100
    palpites = 0

    while inicio <= fim:
        palpite = (inicio + fim) // 2

        print(f"O computador palpitou: {palpite}")

        while True:
            resposta = input(
                "O número pensado é maior, menor ou igual? "
            ).strip().lower()

            if resposta in ["maior", "menor", "igual"]:
                break
            else:
                print("Resposta inválida! Digite maior, menor ou igual.")

        palpites += 1

        if resposta == "igual":
            print(f"\nO computador acertou! O número era {palpite}.")
            print(f"Total de palpites: {palpites}")
            return

        elif resposta == "maior":
            inicio = palpite + 1

        else:
            fim = palpite - 1

    print("\nAs respostas foram inconsistentes.")
    print("Não foi possível encontrar o número.")


jogo_busca_binaria()
